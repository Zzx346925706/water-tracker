<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- 上半部分：标题 + 统计 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧡"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="喝水助手"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF6F00"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0ml / 2000ml"
                android:textSize="12sp"
                android:textColor="#795548"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 进度百分比 -->
        <TextView
            android:id="@+id/widget_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF6F00"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_drawable" />

    <!-- 按钮 2x2 网格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- 第一行：150 250 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_150"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_widget"
                android:gravity="center"
                android:text="💧 150ml"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btn_250"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_widget"
                android:gravity="center"
                android:text="💧 250ml"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 第二行：350 500 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_350"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_widget"
                android:gravity="center"
                android:text="🥤 350ml"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btn_500"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_widget"
                android:gravity="center"
                android:text="🫗 500ml"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
